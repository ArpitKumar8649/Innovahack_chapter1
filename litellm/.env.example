# ============================================================================
# LiteLLM proxy — secrets. Copy to `.env` and fill in your keys.
# `.env` is gitignored; this file is the safe-to-commit template.
# ============================================================================

# Upstream gateway (your current one is pre-filled)
GATEWAY_BASE_URL=https://llm.onerouter.pro

# Up to 8 gateway API keys. KEY_1 is REQUIRED; the rest are optional —
# leave them blank and they are simply skipped. Requests are load-balanced
# across all keys and retried on the next key when one is rate-limited
# (the gateway allows 2 requests/min per key).
# start.sh auto-seeds KEY_1 from your current ANTHROPIC_AUTH_TOKEN if .env
# doesn't exist yet, so the proxy works out of the box with your existing key.
GATEWAY_API_KEY_1=
GATEWAY_API_KEY_2=
GATEWAY_API_KEY_3=
GATEWAY_API_KEY_4=
GATEWAY_API_KEY_5=
GATEWAY_API_KEY_6=
GATEWAY_API_KEY_7=
GATEWAY_API_KEY_8=

# Shared secret Claude Code uses to talk to THIS proxy (Bearer token).
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# If left blank, start.sh generates and persists one on first run.
LITELLM_MASTER_KEY=

# The one model served (only live model on the gateway right now).
# All Claude Code tiers (main/opus/haiku) are pointed at it via use-litellm.env.
MAIN_MODEL=qwen/qwen3.8-max-preview:free
