# Source this in the shell you launch Claude Code from, to route it through
# the local LiteLLM proxy (key rotation across all tiers):
#
#   source litellm/use-litellm.env && claude
#
# To go back to the gateway directly: unset ANTHROPIC_BASE_URL and restore
# your original ANTHROPIC_AUTH_TOKEN.

# Bearer token for the local proxy (must match LITELLM_MASTER_KEY in litellm/.env)
: "${LITELLM_MASTER_KEY:?Set LITELLM_MASTER_KEY first — it's in litellm/.env}"

export ANTHROPIC_BASE_URL="http://localhost:4000"
export ANTHROPIC_AUTH_TOKEN="${LITELLM_MASTER_KEY}"

# Every tier → the one live model, rotated across your keys by the proxy.
# (The gateway's other aliases — claude-opus-4, qwen3.5-397b-a17b, cc/claude-haik —
# currently have no providers upstream.)
export ANTHROPIC_DEFAULT_FABLE_MODEL="claude-main"
export ANTHROPIC_DEFAULT_SONNET_MODEL="claude-main"
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-main"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-main"
export ANTHROPIC_SMALL_FAST_MODEL="claude-main"   # legacy name for the haiku tier
