# VeritasAI backend environment — copy to `.env` and fill in your keys.
# `.env` is gitignored; this template is safe to commit.

# LLM — DashScope (Alibaba Cloud) Qwen
DASHSCOPE_API_KEY=
LLM_MODEL=qwen3.5-plus
LLM_FALLBACK_MODEL=qwen3.6-plus-2026-04-02

# Evidence extraction (full-text)
TAVILY_API_KEY=

# Web / scholar / news search
SERPER_API_KEY=

# Optional observability
# SENTRY_DSN=
